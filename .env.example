# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# PostgreSQL connection
DATABASE_URL=postgres://phi:CHANGE_ME@localhost:5432/phi_blueprint

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Session length in hours
SESSION_HOURS=12

# Secure cookies need HTTPS. Set to false only while testing over plain http.
COOKIE_SECURE=true

# First admin account, created by `npm run seed` if it doesn't exist yet
ADMIN_EMAIL=admin@primaryhomes.com.ph
ADMIN_NAME=Blueprint Admin
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
