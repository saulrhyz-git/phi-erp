# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# PostgreSQL connection
DATABASE_URL=postgres://phi:CHANGE_ME@localhost:5432/phi_blueprint

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Session length in hours
SESSION_HOURS=12

# Secure cookies need HTTPS. Set to false only while testing over plain http.
COOKIE_SECURE=true

# First admin account, created by `npm run seed` if it doesn't exist yet
ADMIN_EMAIL=admin@primaryhomes.com.ph
ADMIN_NAME=Blueprint Admin
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ---------------------------------------------------------------------------
# Document storage in SharePoint / OneDrive (optional). When enabled, uploads go to SharePoint and
# downloads are pulled from SharePoint. See README "SharePoint storage" for the app registration.
SP_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The SharePoint site, library and folder the app uses
SP_SITE_URL=https://primaryhomes.sharepoint.com/sites/ERPProject
SP_LIBRARY=Documents
SP_FOLDER=PHI Blueprint Documents
# Or, instead of SP_SITE_URL + SP_LIBRARY, a drive id (e.g. a OneDrive): SP_DRIVE_ID=b!xxxx
# Check SharePoint for files added or edited there every N minutes (0 = only the manual "Sync" button)
SP_SYNC_MINUTES=15
