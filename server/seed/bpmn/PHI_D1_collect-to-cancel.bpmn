<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DD1_Definitions" targetNamespace="https://primaryhomes.com.ph/bpmn/blueprint" exporter="PHI Enterprise Process Blueprint" exporterVersion="Rev B">
  <bpmn:collaboration id="DD1_Collaboration">
    <bpmn:documentation>D1. Collect-to-cancel — covers 11 Accounts monitoring · 12 Cancellations. Monthly billing and collection with an event-based gateway: either payment arrives, or the due date plus grace lapses and delinquency handling begins, ending in reinstatement or a Maceda-compliant cancellation that returns the unit to inventory.</bpmn:documentation>
    <bpmn:participant id="DD1_Part_PHI" name="Primary Homes, Inc." processRef="DD1_Process" />
    <bpmn:participant id="DD1_Part_buyer" name="Buyer" />
    <bpmn:messageFlow id="DD1_MsgFlow_1" name="SOA" sourceRef="DD1_d2" targetRef="DD1_Part_buyer" />
    <bpmn:messageFlow id="DD1_MsgFlow_2" name="Payment" sourceRef="DD1_Part_buyer" targetRef="DD1_d4" />
    <bpmn:messageFlow id="DD1_MsgFlow_3" name="Notice of cancellation" sourceRef="DD1_d10" targetRef="DD1_Part_buyer" />
    <bpmn:messageFlow id="DD1_MsgFlow_4" name="Refund (if any)" sourceRef="DD1_d12" targetRef="DD1_Part_buyer" />
  </bpmn:collaboration>
  <bpmn:process id="DD1_Process" name="Collect-to-cancel" isExecutable="false">
    <bpmn:laneSet id="DD1_LaneSet">
      <bpmn:lane id="DD1_Lane_cc" name="Credit &amp; collection">
        <bpmn:flowNodeRef>DD1_d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DD1_Lane_acc" name="Cashier &amp; accounting">
        <bpmn:flowNodeRef>DD1_d4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DD1_Lane_legal" name="Legal">
        <bpmn:flowNodeRef>DD1_d10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DD1_Lane_mc" name="Approvers (DOA)">
        <bpmn:flowNodeRef>DD1_d11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DD1_Lane_sadm" name="Sales admin / inventory">
        <bpmn:flowNodeRef>DD1_d13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DD1_d14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="DD1_d1" name="Installment due per schedule">
      <bpmn:outgoing>DD1_Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="DD1_d1_Timer" />
    </bpmn:startEvent>
    <bpmn:task id="DD1_d2" name="Generate and send SOA">
      <bpmn:incoming>DD1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="DD1_d3">
      <bpmn:incoming>DD1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>DD1_Flow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="DD1_d4" name="Payment received">
      <bpmn:incoming>DD1_Flow_3</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="DD1_d4_MsgDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="DD1_d5" name="Issue invoice / receipt; allocate to principal, interest, penalties">
      <bpmn:incoming>DD1_Flow_5</bpmn:incoming>
      <bpmn:incoming>DD1_Flow_9</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DD1_d6" name="Account current">
      <bpmn:incoming>DD1_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="DD1_d7" name="Due date + grace lapsed">
      <bpmn:incoming>DD1_Flow_4</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="DD1_d7_Timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="DD1_d8" name="Compute penalties; send demand letter">
      <bpmn:incoming>DD1_Flow_7</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="DD1_d9" name="Paid within grace period?">
      <bpmn:incoming>DD1_Flow_8</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>DD1_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="DD1_d10" name="Compute cash surrender value; serve notarial notice">
      <bpmn:incoming>DD1_Flow_10</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DD1_d11" name="Approve cancellation and refund / forfeiture">
      <bpmn:incoming>DD1_Flow_11</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DD1_d12" name="Reverse AR and revenue; claw back commission; refund via AP">
      <bpmn:incoming>DD1_Flow_12</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DD1_d13" name="Return unit to inventory as available">
      <bpmn:incoming>DD1_Flow_13</bpmn:incoming>
      <bpmn:outgoing>DD1_Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DD1_d14" name="Unit re-listed">
      <bpmn:incoming>DD1_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="DD1_Flow_1" sourceRef="DD1_d1" targetRef="DD1_d2" />
    <bpmn:sequenceFlow id="DD1_Flow_2" sourceRef="DD1_d2" targetRef="DD1_d3" />
    <bpmn:sequenceFlow id="DD1_Flow_3" sourceRef="DD1_d3" targetRef="DD1_d4" />
    <bpmn:sequenceFlow id="DD1_Flow_4" sourceRef="DD1_d3" targetRef="DD1_d7" />
    <bpmn:sequenceFlow id="DD1_Flow_5" sourceRef="DD1_d4" targetRef="DD1_d5" />
    <bpmn:sequenceFlow id="DD1_Flow_6" sourceRef="DD1_d5" targetRef="DD1_d6" />
    <bpmn:sequenceFlow id="DD1_Flow_7" sourceRef="DD1_d7" targetRef="DD1_d8" />
    <bpmn:sequenceFlow id="DD1_Flow_8" sourceRef="DD1_d8" targetRef="DD1_d9" />
    <bpmn:sequenceFlow id="DD1_Flow_9" name="Yes" sourceRef="DD1_d9" targetRef="DD1_d5" />
    <bpmn:sequenceFlow id="DD1_Flow_10" name="No" sourceRef="DD1_d9" targetRef="DD1_d10" />
    <bpmn:sequenceFlow id="DD1_Flow_11" sourceRef="DD1_d10" targetRef="DD1_d11" />
    <bpmn:sequenceFlow id="DD1_Flow_12" sourceRef="DD1_d11" targetRef="DD1_d12" />
    <bpmn:sequenceFlow id="DD1_Flow_13" sourceRef="DD1_d12" targetRef="DD1_d13" />
    <bpmn:sequenceFlow id="DD1_Flow_14" sourceRef="DD1_d13" targetRef="DD1_d14" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DD1_Diagram" name="D1. Collect-to-cancel">
    <bpmndi:BPMNPlane id="DD1_Plane" bpmnElement="DD1_Collaboration">
      <bpmndi:BPMNShape id="DD1_Part_PHI_di" bpmnElement="DD1_Part_PHI" isHorizontal="true"><dc:Bounds x="0" y="10" width="1754" height="540" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DD1_Lane_cc_di" bpmnElement="DD1_Lane_cc" isHorizontal="true"><dc:Bounds x="30" y="10" width="1724" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DD1_Lane_acc_di" bpmnElement="DD1_Lane_acc" isHorizontal="true"><dc:Bounds x="30" y="118" width="1724" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DD1_Lane_legal_di" bpmnElement="DD1_Lane_legal" isHorizontal="true"><dc:Bounds x="30" y="226" width="1724" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DD1_Lane_mc_di" bpmnElement="DD1_Lane_mc" isHorizontal="true"><dc:Bounds x="30" y="334" width="1724" height="108" /></bpmndi:BPMNShape>
