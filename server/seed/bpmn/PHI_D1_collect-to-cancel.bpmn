      <bpmndi:BPMNShape id="DD1_d7_di" bpmnElement="DD1_d7"><dc:Bounds x="625" y="46" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="588" y="86" width="110" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
