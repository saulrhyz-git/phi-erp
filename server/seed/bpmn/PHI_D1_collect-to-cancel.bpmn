      <bpmndi:BPMNShape id="DD1_d1_di" bpmnElement="DD1_d1"><dc:Bounds x="187" y="46" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="150" y="86" width="110" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
