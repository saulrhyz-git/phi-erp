      <bpmndi:BPMNShape id="DC_c8_di" bpmnElement="DC_c8" isMarkerVisible="true"><dc:Bounds x="1352" y="445" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="1318" y="411" width="110" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DC_c8n_di" bpmnElement="DC_c8n"><dc:Bounds x="1457" y="220" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DC_c9_di" bpmnElement="DC_c9"><dc:Bounds x="1603" y="544" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DC_c10_di" bpmnElement="DC_c10"><dc:Bounds x="1749" y="544" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DC_c11_di" bpmnElement="DC_c11"><dc:Bounds x="1895" y="220" width="124" height="60" /></bpmndi:BPMNShape>
