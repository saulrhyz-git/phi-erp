      <bpmndi:BPMNShape id="DC_c1_di" bpmnElement="DC_c1"><dc:Bounds x="187" y="124" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="150" y="164" width="110" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
