      <bpmndi:BPMNEdge id="DC_Flow_1_di" bpmnElement="DC_Flow_1"><di:waypoint x="223" y="142" /><di:waypoint x="289" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_2_di" bpmnElement="DC_Flow_2"><di:waypoint x="413" y="142" /><di:waypoint x="476" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_3_di" bpmnElement="DC_Flow_3"><di:waypoint x="518" y="142" /><di:waypoint x="532" y="142" /><di:waypoint x="532" y="358" /><di:waypoint x="771" y="358" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="340" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_4_di" bpmnElement="DC_Flow_4"><di:waypoint x="518" y="142" /><di:waypoint x="532" y="142" /><di:waypoint x="532" y="250" /><di:waypoint x="581" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="232" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_5_di" bpmnElement="DC_Flow_5"><di:waypoint x="705" y="250" /><di:waypoint x="719" y="250" /><di:waypoint x="719" y="358" /><di:waypoint x="771" y="358" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_6_di" bpmnElement="DC_Flow_6"><di:waypoint x="807" y="358" /><di:waypoint x="873" y="358" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_7_di" bpmnElement="DC_Flow_7"><di:waypoint x="997" y="358" /><di:waypoint x="1011" y="358" /><di:waypoint x="1011" y="250" /><di:waypoint x="1019" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_8_di" bpmnElement="DC_Flow_8"><di:waypoint x="1143" y="250" /><di:waypoint x="1157" y="250" /><di:waypoint x="1157" y="466" /><di:waypoint x="1165" y="466" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_9_di" bpmnElement="DC_Flow_9"><di:waypoint x="1289" y="466" /><di:waypoint x="1352" y="466" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_10_di" bpmnElement="DC_Flow_10"><di:waypoint x="1394" y="466" /><di:waypoint x="1408" y="466" /><di:waypoint x="1408" y="574" /><di:waypoint x="1603" y="574" /><bpmndi:BPMNLabel><dc:Bounds x="1412" y="556" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_11_di" bpmnElement="DC_Flow_11"><di:waypoint x="1394" y="466" /><di:waypoint x="1408" y="466" /><di:waypoint x="1408" y="250" /><di:waypoint x="1457" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="1412" y="232" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_12_di" bpmnElement="DC_Flow_12"><di:waypoint x="1519" y="280" /><di:waypoint x="1519" y="420" /><di:waypoint x="1227" y="420" /><di:waypoint x="1227" y="436" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_13_di" bpmnElement="DC_Flow_13"><di:waypoint x="1727" y="574" /><di:waypoint x="1749" y="574" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_14_di" bpmnElement="DC_Flow_14"><di:waypoint x="1873" y="574" /><di:waypoint x="1887" y="574" /><di:waypoint x="1887" y="250" /><di:waypoint x="1895" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_Flow_15_di" bpmnElement="DC_Flow_15"><di:waypoint x="2019" y="250" /><di:waypoint x="2085" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DC_MsgFlow_1_di" bpmnElement="DC_MsgFlow_1"><di:waypoint x="205" y="70" /><di:waypoint x="205" y="124" /><bpmndi:BPMNLabel><dc:Bounds x="211" y="89" width="160" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
