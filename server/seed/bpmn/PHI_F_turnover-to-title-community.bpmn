<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DF_Definitions" targetNamespace="https://primaryhomes.com.ph/bpmn/blueprint" exporter="PHI Enterprise Process Blueprint" exporterVersion="Rev B">
  <bpmn:collaboration id="DF_Collaboration">
    <bpmn:documentation>F. Turnover-to-title &amp; community — covers 15 Unit preparation &amp; delivery · 14 TORC · 19 Title delivery · 18 Property management. A completed unit is inspected and turned over when the account is eligible; a parallel split then starts homeowner onboarding and the title-transfer track, which ends with the title delivered to the buyer or lender.</bpmn:documentation>
    <bpmn:participant id="DF_Part_PHI" name="Primary Homes, Inc." processRef="DF_Process" />
    <bpmn:participant id="DF_Part_buyer" name="Buyer" />
    <bpmn:participant id="DF_Part_gov" name="BIR, RD, assessor" />
    <bpmn:messageFlow id="DF_MsgFlow_1" name="Turnover schedule" sourceRef="DF_g4" targetRef="DF_Part_buyer" />
    <bpmn:messageFlow id="DF_MsgFlow_2" name="Taxes, fees, filings" sourceRef="DF_g10" targetRef="DF_Part_gov" />
    <bpmn:messageFlow id="DF_MsgFlow_3" name="New title, tax declaration" sourceRef="DF_Part_gov" targetRef="DF_g11" />
    <bpmn:messageFlow id="DF_MsgFlow_4" name="Title (or to lender)" sourceRef="DF_g12" targetRef="DF_Part_buyer" />
  </bpmn:collaboration>
  <bpmn:process id="DF_Process" name="Turnover-to-title &amp; community" isExecutable="false">
    <bpmn:laneSet id="DF_LaneSet">
      <bpmn:lane id="DF_Lane_con" name="Construction &amp; QA">
        <bpmn:flowNodeRef>DF_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g5n</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DF_Lane_cc" name="Credit &amp; collection">
        <bpmn:flowNodeRef>DF_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g3n</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DF_Lane_cx" name="Customer care / turnover">
        <bpmn:flowNodeRef>DF_g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DF_Lane_pm" name="Property management">
        <bpmn:flowNodeRef>DF_g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DF_Lane_tit" name="Titling">
        <bpmn:flowNodeRef>DF_g9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DF_g13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="DF_g1" name="Unit ready for occupancy">
      <bpmn:outgoing>DF_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="DF_g2" name="Internal QA and punch list">
      <bpmn:incoming>DF_Flow_1</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="DF_g3" name="Turnover-eligible?">
      <bpmn:incoming>DF_Flow_2</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>DF_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="DF_g3n" name="Hold until eligible">
      <bpmn:incoming>DF_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="DF_g4" name="Schedule turnover and joint inspection">
      <bpmn:incoming>DF_Flow_3</bpmn:incoming>
      <bpmn:incoming>DF_Flow_8</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="DF_g5" name="Buyer accepts unit?">
      <bpmn:incoming>DF_Flow_5</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>DF_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="DF_g5n" name="Rectify defects">
      <bpmn:incoming>DF_Flow_7</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DF_g6" name="Sign acceptance; hand over keys; start warranty">
      <bpmn:incoming>DF_Flow_6</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="DF_g7">
      <bpmn:incoming>DF_Flow_9</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>DF_Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="DF_g8" name="Onboard homeowner; start dues billing">
      <bpmn:incoming>DF_Flow_10</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DF_g14" name="Service requests, dues collection, PM expenses">
      <bpmn:incoming>DF_Flow_12</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DF_g15" name="Turn over to HOA when criteria are met">
      <bpmn:incoming>DF_Flow_13</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DF_g16" name="HOA turned over">
      <bpmn:incoming>DF_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="DF_g9" name="Prepare DOAS; compute and fund TORC (taxes and other related charges)">
      <bpmn:incoming>DF_Flow_11</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DF_g10" name="Pay taxes and fees; process eCAR and transfer">
      <bpmn:incoming>DF_Flow_15</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="DF_g11" name="New TCT / CCT issued">
      <bpmn:incoming>DF_Flow_16</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="DF_g11_MsgDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="DF_g12" name="Deliver title to buyer or lender">
      <bpmn:incoming>DF_Flow_17</bpmn:incoming>
      <bpmn:outgoing>DF_Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DF_g13" name="Title delivered">
      <bpmn:incoming>DF_Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="DF_Flow_1" sourceRef="DF_g1" targetRef="DF_g2" />
    <bpmn:sequenceFlow id="DF_Flow_2" sourceRef="DF_g2" targetRef="DF_g3" />
    <bpmn:sequenceFlow id="DF_Flow_3" name="Yes" sourceRef="DF_g3" targetRef="DF_g4" />
    <bpmn:sequenceFlow id="DF_Flow_4" name="No" sourceRef="DF_g3" targetRef="DF_g3n" />
    <bpmn:sequenceFlow id="DF_Flow_5" sourceRef="DF_g4" targetRef="DF_g5" />
    <bpmn:sequenceFlow id="DF_Flow_6" name="Yes" sourceRef="DF_g5" targetRef="DF_g6" />
    <bpmn:sequenceFlow id="DF_Flow_7" name="No" sourceRef="DF_g5" targetRef="DF_g5n" />
    <bpmn:sequenceFlow id="DF_Flow_8" sourceRef="DF_g5n" targetRef="DF_g4" />
    <bpmn:sequenceFlow id="DF_Flow_9" sourceRef="DF_g6" targetRef="DF_g7" />
    <bpmn:sequenceFlow id="DF_Flow_10" sourceRef="DF_g7" targetRef="DF_g8" />
    <bpmn:sequenceFlow id="DF_Flow_11" sourceRef="DF_g7" targetRef="DF_g9" />
    <bpmn:sequenceFlow id="DF_Flow_12" sourceRef="DF_g8" targetRef="DF_g14" />
    <bpmn:sequenceFlow id="DF_Flow_13" sourceRef="DF_g14" targetRef="DF_g15" />
    <bpmn:sequenceFlow id="DF_Flow_14" sourceRef="DF_g15" targetRef="DF_g16" />
    <bpmn:sequenceFlow id="DF_Flow_15" sourceRef="DF_g9" targetRef="DF_g10" />
    <bpmn:sequenceFlow id="DF_Flow_16" sourceRef="DF_g10" targetRef="DF_g11" />
    <bpmn:sequenceFlow id="DF_Flow_17" sourceRef="DF_g11" targetRef="DF_g12" />
    <bpmn:sequenceFlow id="DF_Flow_18" sourceRef="DF_g12" targetRef="DF_g13" />
  </bpmn:process>
