<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DB_Definitions" targetNamespace="https://primaryhomes.com.ph/bpmn/blueprint" exporter="PHI Enterprise Process Blueprint" exporterVersion="Rev B">
  <bpmn:collaboration id="DB_Collaboration">
    <bpmn:documentation>B. Land-to-inventory — covers 04 Land acquisition · 05 Project setup · 07 Inventory setup. From a land opportunity to sellable lots: due diligence, agreement, milestone payments, title transfer, project creation, permits and License to Sell, then lot master and price-list creation.</bpmn:documentation>
    <bpmn:participant id="DB_Part_PHI" name="Primary Homes, Inc." processRef="DB_Process" />
    <bpmn:participant id="DB_Part_lo" name="Landowner / seller" />
    <bpmn:participant id="DB_Part_gov" name="BIR, RD, LGU, DHSUD" />
    <bpmn:messageFlow id="DB_MsgFlow_1" name="Signed agreement" sourceRef="DB_b5" targetRef="DB_Part_lo" />
    <bpmn:messageFlow id="DB_MsgFlow_2" name="Milestone payment" sourceRef="DB_b6" targetRef="DB_Part_lo" />
    <bpmn:messageFlow id="DB_MsgFlow_3" name="Taxes and transfer documents" sourceRef="DB_b7" targetRef="DB_Part_gov" />
    <bpmn:messageFlow id="DB_MsgFlow_4" name="eCAR, new TCT" sourceRef="DB_Part_gov" targetRef="DB_b8" />
    <bpmn:messageFlow id="DB_MsgFlow_5" name="Permit and LTS applications" sourceRef="DB_b10" targetRef="DB_Part_gov" />
  </bpmn:collaboration>
  <bpmn:process id="DB_Process" name="Land-to-inventory" isExecutable="false">
    <bpmn:laneSet id="DB_LaneSet">
      <bpmn:lane id="DB_Lane_bd" name="Land acquisition / BD">
        <bpmn:flowNodeRef>DB_b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DB_Lane_mc" name="ManCom">
        <bpmn:flowNodeRef>DB_b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b4n</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DB_Lane_legal" name="Legal &amp; titling">
        <bpmn:flowNodeRef>DB_b5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DB_Lane_tre" name="Treasury &amp; AP">
        <bpmn:flowNodeRef>DB_b6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DB_Lane_pdd" name="Project Development">
        <bpmn:flowNodeRef>DB_b9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DB_Lane_sadm" name="Sales admin">
        <bpmn:flowNodeRef>DB_b11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DB_b12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="DB_b1" name="Land opportunity logged">
      <bpmn:outgoing>DB_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="DB_b2" name="Due diligence: title, survey, zoning, appraisal">
      <bpmn:incoming>DB_Flow_1</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DB_b3" name="Evaluate acquisition and feasibility">
      <bpmn:incoming>DB_Flow_2</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="DB_b4" name="Approve?">
      <bpmn:incoming>DB_Flow_3</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>DB_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="DB_b4n" name="Declined">
      <bpmn:incoming>DB_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="DB_b5" name="Negotiate and execute agreement (deed or JV)">
      <bpmn:incoming>DB_Flow_5</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DB_b6" name="Release milestone payments">
      <bpmn:incoming>DB_Flow_6</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DB_b7" name="Pay CGT, DST and transfer tax; file for transfer">
      <bpmn:incoming>DB_Flow_7</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="DB_b8" name="New title issued">
      <bpmn:incoming>DB_Flow_8</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="DB_b8_MsgDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="DB_b9" name="Create project, phases, WBS and analytic account">
      <bpmn:incoming>DB_Flow_9</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DB_b10" name="Secure permits and License to Sell">
      <bpmn:incoming>DB_Flow_10</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DB_b11" name="Create lots (unit master), price list and financing options">
      <bpmn:incoming>DB_Flow_11</bpmn:incoming>
      <bpmn:outgoing>DB_Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DB_b12" name="Units open for sale">
      <bpmn:incoming>DB_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="DB_Flow_1" sourceRef="DB_b1" targetRef="DB_b2" />
    <bpmn:sequenceFlow id="DB_Flow_2" sourceRef="DB_b2" targetRef="DB_b3" />
    <bpmn:sequenceFlow id="DB_Flow_3" sourceRef="DB_b3" targetRef="DB_b4" />
    <bpmn:sequenceFlow id="DB_Flow_4" name="No" sourceRef="DB_b4" targetRef="DB_b4n" />
    <bpmn:sequenceFlow id="DB_Flow_5" name="Yes" sourceRef="DB_b4" targetRef="DB_b5" />
    <bpmn:sequenceFlow id="DB_Flow_6" sourceRef="DB_b5" targetRef="DB_b6" />
    <bpmn:sequenceFlow id="DB_Flow_7" sourceRef="DB_b6" targetRef="DB_b7" />
    <bpmn:sequenceFlow id="DB_Flow_8" sourceRef="DB_b7" targetRef="DB_b8" />
    <bpmn:sequenceFlow id="DB_Flow_9" sourceRef="DB_b8" targetRef="DB_b9" />
    <bpmn:sequenceFlow id="DB_Flow_10" sourceRef="DB_b9" targetRef="DB_b10" />
    <bpmn:sequenceFlow id="DB_Flow_11" sourceRef="DB_b10" targetRef="DB_b11" />
    <bpmn:sequenceFlow id="DB_Flow_12" sourceRef="DB_b11" targetRef="DB_b12" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DB_Diagram" name="B. Land-to-inventory">
    <bpmndi:BPMNPlane id="DB_Plane" bpmnElement="DB_Collaboration">
      <bpmndi:BPMNShape id="DB_Part_PHI_di" bpmnElement="DB_Part_PHI" isHorizontal="true"><dc:Bounds x="0" y="88" width="1900" height="648" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Lane_bd_di" bpmnElement="DB_Lane_bd" isHorizontal="true"><dc:Bounds x="30" y="88" width="1870" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Lane_mc_di" bpmnElement="DB_Lane_mc" isHorizontal="true"><dc:Bounds x="30" y="196" width="1870" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Lane_legal_di" bpmnElement="DB_Lane_legal" isHorizontal="true"><dc:Bounds x="30" y="304" width="1870" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Lane_tre_di" bpmnElement="DB_Lane_tre" isHorizontal="true"><dc:Bounds x="30" y="412" width="1870" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Lane_pdd_di" bpmnElement="DB_Lane_pdd" isHorizontal="true"><dc:Bounds x="30" y="520" width="1870" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Lane_sadm_di" bpmnElement="DB_Lane_sadm" isHorizontal="true"><dc:Bounds x="30" y="628" width="1870" height="108" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Part_lo_di" bpmnElement="DB_Part_lo" isHorizontal="true"><dc:Bounds x="0" y="10" width="1900" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_Part_gov_di" bpmnElement="DB_Part_gov" isHorizontal="true"><dc:Bounds x="0" y="754" width="1900" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b1_di" bpmnElement="DB_b1"><dc:Bounds x="187" y="124" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="150" y="164" width="110" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b2_di" bpmnElement="DB_b2"><dc:Bounds x="289" y="112" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b3_di" bpmnElement="DB_b3"><dc:Bounds x="435" y="220" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b4_di" bpmnElement="DB_b4" isMarkerVisible="true"><dc:Bounds x="622" y="229" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="588" y="208" width="110" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b4n_di" bpmnElement="DB_b4n"><dc:Bounds x="771" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="734" y="272" width="110" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b5_di" bpmnElement="DB_b5"><dc:Bounds x="727" y="328" width="124" height="60" /></bpmndi:BPMNShape>
