      <bpmndi:BPMNEdge id="DB_Flow_6_di" bpmnElement="DB_Flow_6"><di:waypoint x="851" y="358" /><di:waypoint x="865" y="358" /><di:waypoint x="865" y="466" /><di:waypoint x="873" y="466" /></bpmndi:BPMNEdge>
