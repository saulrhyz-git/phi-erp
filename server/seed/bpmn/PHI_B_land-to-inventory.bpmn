      <bpmndi:BPMNEdge id="DB_Flow_8_di" bpmnElement="DB_Flow_8"><di:waypoint x="1143" y="358" /><di:waypoint x="1209" y="358" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DB_Flow_9_di" bpmnElement="DB_Flow_9"><di:waypoint x="1245" y="358" /><di:waypoint x="1259" y="358" /><di:waypoint x="1259" y="574" /><di:waypoint x="1311" y="574" /></bpmndi:BPMNEdge>
