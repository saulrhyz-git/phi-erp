      <bpmndi:BPMNEdge id="DB_MsgFlow_5_di" bpmnElement="DB_MsgFlow_5"><di:waypoint x="1519" y="604" /><di:waypoint x="1519" y="754" /><bpmndi:BPMNLabel><dc:Bounds x="1525" y="671" width="160" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
