      <bpmndi:BPMNShape id="DB_b7_di" bpmnElement="DB_b7"><dc:Bounds x="1019" y="328" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b8_di" bpmnElement="DB_b8"><dc:Bounds x="1209" y="340" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1172" y="380" width="110" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b9_di" bpmnElement="DB_b9"><dc:Bounds x="1311" y="544" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b10_di" bpmnElement="DB_b10"><dc:Bounds x="1457" y="544" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b11_di" bpmnElement="DB_b11"><dc:Bounds x="1603" y="652" width="124" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DB_b12_di" bpmnElement="DB_b12"><dc:Bounds x="1793" y="664" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1756" y="704" width="110" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DB_Flow_1_di" bpmnElement="DB_Flow_1"><di:waypoint x="223" y="142" /><di:waypoint x="289" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DB_Flow_2_di" bpmnElement="DB_Flow_2"><di:waypoint x="413" y="142" /><di:waypoint x="427" y="142" /><di:waypoint x="427" y="250" /><di:waypoint x="435" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DB_Flow_3_di" bpmnElement="DB_Flow_3"><di:waypoint x="559" y="250" /><di:waypoint x="622" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DB_Flow_4_di" bpmnElement="DB_Flow_4"><di:waypoint x="664" y="250" /><di:waypoint x="771" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="668" y="232" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
