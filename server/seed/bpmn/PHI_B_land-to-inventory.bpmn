      <bpmndi:BPMNEdge id="DB_MsgFlow_1_di" bpmnElement="DB_MsgFlow_1"><di:waypoint x="829" y="328" /><di:waypoint x="829" y="70" /><bpmndi:BPMNLabel><dc:Bounds x="835" y="191" width="160" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DB_MsgFlow_2_di" bpmnElement="DB_MsgFlow_2"><di:waypoint x="935" y="436" /><di:waypoint x="935" y="70" /><bpmndi:BPMNLabel><dc:Bounds x="941" y="245" width="160" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
